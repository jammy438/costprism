{
  "name": "costprism-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "prettier": "^3.7.4",
    "turbo": "^2.8.14",
